# Cloudinary — use either CLOUDINARY_URL or the three variables below (not both required if URL is set).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder in Cloudinary (subpaths from the app are appended, e.g. ecommerce-store/products)
CLOUDINARY_FOLDER=ecommerce-store

# Server
# PORT=3000

# MongoDB
# MONGO_URI=mongodb+srv://...

# Optional: first-run seed when the users collection is empty (override in production)
# SEED_SUPER_ADMIN_EMAIL=cto.innovate@gmail.com
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_NAME=Super Admin
# SEED_DEFAULT_BRANCH_NAME=مدينة نصر
# SEED_DEFAULT_BRANCH_ADDRESS=مدينة نصر، القاهرة
# SEED_SECOND_BRANCH_NAME=التجمع الخامس
# SEED_SECOND_BRANCH_ADDRESS=التجمع الخامس، القاهرة
# SEED_SKIP_SECOND_BRANCH=false

# Vixa (AI assistant)
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# INTERNET_ALLOWED=false
# Optional: unlock e-commerce storefront integration in Settings
# ECOMMERCE_INTEGRATION_FEATURE=false

