{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "angular"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
